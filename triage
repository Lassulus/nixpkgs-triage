  merged_at TEXT,
  base_ref TEXT,
  additions INTEGER,
  deletions INTEGER,
  changed_files INTEGER,
  review_decision TEXT,
  ci_state TEXT,
  comments INTEGER,
  labels TEXT NOT NULL,
  files TEXT NOT NULL,
  files_total INTEGER,
  category TEXT,
